# meow bot

# Discord bot token. Keep this secret.
TOKEN=

# Optional. Sync slash commands to one server during development.
GUILD_ID=

# Optional. Set to 1 to log commands, messages, and app debug output to the console.
DEBUG=

# Optional. Errors at ERROR level are posted here.
ERROR_WEBHOOK_URL=

# Optional. This user is pinged on critical errors.
ALLOWED_USER_ID=

# Invite link used by the bot and website.
DISCORD_INVITE_URL=https://discord.com/oauth2/authorize?client_id=1446086806926786581&scope=bot%20applications.commands&permissions=84992

# Optional support server or contact link.
SUPPORT_URL=

# Path to the SQLite database. The bot and website must use the same file.
MEOW_DB_PATH=database.db

# Website settings.
SITE_URL=http://localhost:8000
FLASK_HOST=127.0.0.1
FLASK_PORT=8000
FLASK_DEBUG=0
CACHE_TTL=20

# Optional. Override the source link.
GITHUB_URL=https://github.com/xangeyfun/Meow-Bot
